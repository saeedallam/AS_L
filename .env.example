# =============================================================================
# مكتبة أسماء النموذجية — environment variables
# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment
# Variables. Names and descriptions only: never put real secrets in this file.
# =============================================================================

# Public canonical URL of the site, no trailing slash.
# Used for canonical URLs, sitemap.xml, Open Graph and WhatsApp product links.
# Example: https://www.example.com  (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Supabase project URL — Supabase Dashboard → Project Settings → API → Project URL
# Example: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...) or legacy "anon" key.
# Safe in the browser: every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Secret salt for hashing visitor IPs used by contact-form rate
# limiting (raw IPs are never stored). Any long random string. SERVER ONLY.
IP_HASH_SALT=

# Secret for the daily keep-alive cron (vercel.json -> /api/health).
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# Use a random string of at least 32 characters. SERVER ONLY.
CRON_SECRET=

# NOT NEEDED: the app never uses the Supabase service-role key. Do not add it
# to Vercel. Admin access = Supabase Auth user + profiles.role = 'admin'.
